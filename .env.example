# CipherPay backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3080

# Server-only Shopify setup proxy configuration.
# These must NOT use NEXT_PUBLIC_.
SHOPIFY_SETUP_API_URL=https://connect.cipherpay.app
SHOPIFY_SETUP_ADMIN_TOKEN=your_shopify_setup_admin_token
SHOPIFY_STATUS_TOKEN_SECRET=generate_a_long_random_secret

# Optional cross-chain checkout; enable after deploying API and funded qualification.
NEXT_PUBLIC_CROSSCHAIN_ENABLED=false
# Server-only Solana mainnet RPC; keep credentials out of NEXT_PUBLIC variables.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Separate private staging project only (leave unset on the public project).
# STAGING_MODE=true
# STAGING_PASSWORD=generate_a_random_password_of_at_least_24_characters
# STAGING_API_URL=https://api.testnet.cipherpay.app/staging
# STAGING_API_KEY=generate_a_separate_random_proxy_key
# NEXT_PUBLIC_API_URL=/api/staging
